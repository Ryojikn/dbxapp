# Demo mode: "fixture" uses pre-baked responses (default, no external calls)
#            "live"    proxies chat to a Databricks Model Serving endpoint
DEMO_MODE=fixture

# Required only when DEMO_MODE=live
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_TOKEN=<personal-access-token>
DATABRICKS_SERVING_ENDPOINT=<endpoint-name>

# Server port (injected automatically by Databricks Apps runtime)
PORT=8050
